# Target hardware: Espressif ESP32-S3-USB-OTG (ESP32-S3-MINI-1-N8, 8 MB flash)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Dual OTA slots with rollback. A new image is marked valid only after all
# critical services initialize and the configured stability window elapses.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Startup work runs on the main task; the ESP-IDF default (3584 bytes) is too
# small for the service initializers and caused a boot loop.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Console only on UART0 (the Micro-USB USB-to-UART port). The native USB PHY
# belongs to the USB host stack for the modem.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Keep a core dump of the last crash in flash; its summary is shown on the
# display, in /api/v1/status and in the setup portal.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=12

# Keep the watchdog enabled from the beginning of the project.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# Sensible production defaults. Verbose modem traces can be enabled at runtime
# later without making DEBUG the firmware-wide default.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Browser setup portal runs on a WPA2-protected SoftAP.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# CA bundle for mqtts:// brokers without a custom CA
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# External powered USB hubs are supported for high-current cellular modems.
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# M7 OTA rollback confirmation: after all critical services start, a new image
# must remain alive for this window before it is marked valid.
CONFIG_GATEWAY_OTA_CONFIRM_DELAY_SECONDS=30
